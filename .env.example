# Mawjood environment template.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# In deployed environments these come from a managed secret store, not a file.
#
# Every key is read by mawjood/config.py with the MAWJOOD_ prefix.

# --- Identity ---------------------------------------------------------------
MAWJOOD_SERVICE_NAME=mawjood
# local | dev | staging | prod
MAWJOOD_ENVIRONMENT=local
MAWJOOD_DEBUG=false

# --- Residency and locale ---------------------------------------------------
# Where consumer data lives. One of: gcc | eu | india.
# There is no US option, and a US-looking MAWJOOD_REGION is refused at startup.
MAWJOOD_DATA_RESIDENCY=gcc
# The provider-specific region code for whichever cloud is chosen in Phase 4.
MAWJOOD_REGION=me-central-1
MAWJOOD_TIMEZONE=Asia/Dubai
MAWJOOD_DEFAULT_LOCALE=en

# --- Database ---------------------------------------------------------------
# Required. Must use the asyncpg driver. Use a least-privilege application user;
# migrations run as a separate, more privileged user (see docs/RUNBOOK.md).
MAWJOOD_DATABASE_URL=postgresql+asyncpg://CHANGEME_USER:CHANGEME_PASSWORD@localhost:5432/mawjood
MAWJOOD_DATABASE_POOL_SIZE=5
MAWJOOD_DATABASE_MAX_OVERFLOW=5
MAWJOOD_DATABASE_CONNECT_TIMEOUT_S=5.0
MAWJOOD_DATABASE_ECHO=false

# --- Conversation turn budget ----------------------------------------------
# Soft deadline per turn in milliseconds. When it expires mid-cascade Mawjood
# emits a holding pivot and finishes the cascade in the background.
MAWJOOD_TURN_DEADLINE_MS=2500

# --- Tenancy ----------------------------------------------------------------
# v1 runs one operator. Configuration rather than a constant so multi-tenant
# routing later is a resolver change, not a schema change.
MAWJOOD_DEFAULT_TENANT_SLUG=mawjood
MAWJOOD_DEFAULT_TENANT_NAME=Mawjood

# --- WhatsApp provider (BSP) ------------------------------------------------
# 360dialog | wati | console
MAWJOOD_BSP_PROVIDER=360dialog
# HMAC key used to verify inbound webhook signatures. REQUIRED in production.
MAWJOOD_BSP_WEBHOOK_SECRET=
# Shared token echoed during the provider's subscription handshake.
MAWJOOD_BSP_VERIFY_TOKEN=
# Outbound send. Not needed to receive; replies queue until these are set.
MAWJOOD_BSP_API_BASE=
MAWJOOD_BSP_API_KEY=
# Refusing unsigned webhooks is the default. Setting this false is a local
# convenience for curl and is rejected outright when environment=prod.
MAWJOOD_BSP_REQUIRE_SIGNATURE=true

# --- Startup behaviour ------------------------------------------------------
# docker-compose sets both true so one command gives a working stack.
MAWJOOD_RUN_MIGRATIONS_ON_START=false
MAWJOOD_SEED_DEV_TENANT_ON_START=false

# --- Observability ----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
MAWJOOD_LOG_LEVEL=INFO
# json for anything deployed; console is easier to read locally.
MAWJOOD_LOG_FORMAT=json
MAWJOOD_SENTRY_DSN=
MAWJOOD_SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Retention --------------------------------------------------------------
MAWJOOD_LOG_RETENTION_DAYS=90
MAWJOOD_DATA_RETENTION_DAYS=365

# --- docker-compose only ----------------------------------------------------
# Credentials for the local postgres container. Local development only.
POSTGRES_USER=mawjood
POSTGRES_PASSWORD=CHANGEME_LOCAL_ONLY
POSTGRES_DB=mawjood

# --- Tests ------------------------------------------------------------------
# Set to run the integration suite against a live database (make test-integration).
# Unit tests never need this and never open a socket.
MAWJOOD_TEST_DATABASE_URL=

# ============================================================================
# Reserved for later phases. Listed so operators know what is coming; nothing
# reads these yet.
#
#   Phase 2 — conversation and Zenoti
#     MAWJOOD_LLM_PROVIDER=openai
#     MAWJOOD_LLM_MODEL=gpt-4o-mini
#     MAWJOOD_OPENAI_API_KEY=
#     MAWJOOD_ZENOTI_API_BASE=
#
#   Phase 3 — notifications and console
#     MAWJOOD_BSP_PHONE_NUMBER=
#     MAWJOOD_CONSOLE_SESSION_SECRET=
#
#   Phase 4 — hardening
#     MAWJOOD_BACKUP_BUCKET=
#     MAWJOOD_SECRETS_BACKEND=env           # env | gcp | aws | azure | vault
# ============================================================================
